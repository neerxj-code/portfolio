/* =========================================
   SIDE EMAIL
========================================= */

.side-email {
  position: fixed;

  left: 8px;
  top: 50%;

  z-index: 20;

  writing-mode: vertical-rl;

  transform: rotate(180deg);

  color: #999;

  font-size: 9px;

  letter-spacing: 0.5px;
}

/* =========================================
   PROJECTS
========================================= */

.projects {
  padding-top: 100px;
  padding-bottom: 100px;
}

.projects-layout {
  display: grid;

  grid-template-columns: 1fr 360px;

  gap: 60px;
}

.project-list {
  width: 100%;
}

.project {
  display: grid;

  grid-template-columns: 30px 1fr;

  width: 100%;

  padding: 10px 0 13px;

  border-top: 1px solid var(--line);

  color: #888;

  text-align: left;

  transition:
    color 0.35s,
    transform 0.35s;
}

.project:last-child {
  border-bottom: 1px solid var(--line);
}

.project:hover,
.project.active {
  color: #eee;

  transform: translateX(5px);
}

.project-number {
  padding-top: 8px;

  font-family: var(--display);

  font-size: 10px;
}

.project-information h2 {
  font-family: var(--display);

  font-size: 39px;

  line-height: 1;

  letter-spacing: -1px;
}

.project-information span {
  display: block;

  margin-top: 5px;

  color: #777;

  font-size: 7px;
}

.external {
  display: inline-block;

  margin-left: 7px;

  font-family: Arial;

  font-size: 18px;
}

.project.active h2 {
  color: #ddd;
}

.project:last-child.active h2 {
  color: var(--green);
}


/* =========================================
   PROJECT PREVIEW
========================================= */

.project-preview {
  display: flex;

  align-items: center;
  justify-content: center;

  min-height: 340px;
}

.preview-card {
  width: 100%;

  opacity: 1;

  transition:
    opacity 0.3s,
    transform 0.5s;
}

.preview-browser {
  overflow: hidden;

  width: 100%;

  aspect-ratio: 1.5;

  background: white;

  box-shadow:
    0 15px 50px rgba(0, 0, 0, 0.4);
}

.browser-top {
  display: flex;

  align-items: center;

  gap: 4px;

  height: 15px;

  padding-left: 7px;

  background: #eee;
}

.browser-top span {
  width: 4px;
  height: 4px;

  border-radius: 50%;

  background: #aaa;
}

.preview-content {
  display: flex;

  height: calc(100% - 15px);

  padding: 15px;

  color: #222;
}

.preview-sidebar {
  display: flex;

  flex-direction: column;

  gap: 7px;

  width: 25%;

  padding: 10px;

  border-radius: 8px;

  background: #f4f4f4;
}

.preview-sidebar div {
  height: 13px;

  border-radius: 3px;

  background: #ddd;
}

.preview-sidebar div:first-child {
  background: #111;
}

.preview-form {
  flex: 1;

  padding: 5px 12px;
}

.preview-form h4 {
  margin-bottom: 15px;

  font-size: 10px;
}

.preview-form div {
  height: 12px;

  margin-bottom: 7px;

  border-bottom: 1px solid #ddd;
}

.fake-project {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 100%;
  height: 100%;

  background: #eee;

  font-family: var(--display);

  font-size: 35px;

  color: #222;
}


/* =========================================
   CONTACT
========================================= */

.contact {
  display: flex;

  align-items: flex-end;
  justify-content: center;

  min-height: 75vh;

  padding-bottom: 30px;
}

.contact-inner {
  text-align: center;
}

.contact-question {
  display: block;

  margin-bottom: 12px;

  color: #999;

  font-size: 10px;
}

.contact-email {
  display: block;

  color: #ddd;

  font-family: var(--display);

  font-size: 24px;

  transition: color 0.25s;
}

.contact-email:hover {
  color: var(--green);
}

.contact-inner p {
  margin-top: 25px;

  color: #777;

  font-size: 8px;
}

.contact-stats {
  display: flex;

  justify-content: center;

  gap: 20px;

  margin-top: 8px;

  color: #777;

  font-size: 8px;
}